# 秘密情報
.env
.env.*

# Python
__pycache__/
*.pyc
.venv/

# ダウンロードした元データ（容量が大きい。再配布しない）
data/raw/

# 動画・音声の素材（リポジトリに含めない）
video/
*.mp4
*.mov
*.m4a
*.wav
*.webm
*.mp3
# 合成音声で作るアプリの音声（scripts/make_voice.py が作る。manifest.json も含めて除く）
web/audio/

# 実行時に生成されるファイル
app/logs/
eval/runs/

# Claude Code の個人設定と、セッションごとの worktree
.claude/settings.local.json
.claude/worktrees/
